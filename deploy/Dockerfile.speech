# CPU speech baseline. A CUDA variant needs a separately validated torch/driver image.
FROM python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends espeak-ng && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml ./
COPY duplex_voice ./duplex_voice
COPY scripts ./scripts
RUN pip install --no-cache-dir '.[speech]' && python -m spacy download en_core_web_sm && useradd --create-home voice
USER voice
EXPOSE 8001
CMD ["uvicorn","duplex_voice.speech_service:app","--host","0.0.0.0","--port","8001","--workers","1","--ws-max-size","65536","--ws-max-queue","16","--no-access-log"]
