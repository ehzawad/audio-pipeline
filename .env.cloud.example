# REAL HOSTED MODE. Hosted models need accounts; they are not downloadable HF weights.
VOICE_MODE=cloud
DEPLOYMENT=development
PUBLIC_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
APP_TOKEN=
SIGNING_KEY=
MAX_SESSIONS=4
VAD_BACKEND=silero
VAD_MODEL_PATH=models/silero_vad.onnx
ASR_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
# Any compatible streaming Chat Completions endpoint, including a hosted HF deployment.
# Set an actual model ID permitted by that endpoint. No arbitrary model auto-selection.
LLM_BASE_URL=https://your-provider.example/v1
LLM_MODEL=replace-with-your-provider-model-id
LLM_API_KEY=
LLM_TOKEN_PARAMETER=max_tokens
LLM_SEND_TEMPERATURE=true
RTC_ENABLED=true
RTC_ICE_SERVERS_JSON=[]
TWILIO_ENABLED=false
TWILIO_VALIDATE=true
OUTBOUND_ENABLED=false
AUDIOSOCKET_ENABLED=false
