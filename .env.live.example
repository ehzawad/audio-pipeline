# GPT-LIVE MODE: one full-duplex OpenAI Live session per call replaces VAD, ASR, LLM and TTS.
# The model owns turn-taking and interruption; the gateway keeps admission, leases, transports,
# pacing and cleanup. Billed per session second plus the delegated backend model.
# OPENAI_API_KEY is read from the process environment. Do not paste it into a tracked file.
VOICE_MODE=live
DEPLOYMENT=development
PUBLIC_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
APP_TOKEN=
SIGNING_KEY=
MAX_SESSIONS=4
LIVE_MODEL=gpt-live-1
LIVE_VOICE=marin
LIVE_DELEGATE_MODEL=gpt-5.6-luna
RTC_ENABLED=true
RTC_ICE_SERVERS_JSON=[]
TWILIO_ENABLED=false
TWILIO_VALIDATE=true
OUTBOUND_ENABLED=false
AUDIOSOCKET_ENABLED=false
