# REAL LOCAL MODE. Download models and start the speech and LLM services first.
VOICE_MODE=local
DEPLOYMENT=development
PUBLIC_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
APP_TOKEN=
SIGNING_KEY=
MAX_SESSIONS=4
VAD_BACKEND=silero
VAD_MODEL_PATH=models/silero_vad.onnx
ASR_PROVIDER=speech
TTS_PROVIDER=speech
SPEECH_BASE_URL=http://127.0.0.1:8001
SPEECH_TOKEN=replace-with-a-random-private-service-token
SPEECH_MAX_REQUESTS=8
ASR_MODEL_DIR=models/zipformer
TTS_MODEL_DIR=models/kokoro
KOKORO_VOICE=af_heart
TTS_DEVICE=cpu
LLM_BASE_URL=http://127.0.0.1:8002/v1
LLM_MODEL=voice-llm
LLM_API_KEY=
LLM_MAX_TOKENS=256
LLM_TOKEN_PARAMETER=max_tokens
LLM_SEND_TEMPERATURE=true
RTC_ENABLED=true
RTC_ICE_SERVERS_JSON=[]
TWILIO_ENABLED=false
TWILIO_VALIDATE=true
OUTBOUND_ENABLED=false
AUDIOSOCKET_ENABLED=false
