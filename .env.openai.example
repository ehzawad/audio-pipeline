# REAL HOSTED MODE through one OpenAI account: realtime transcription, chat and speech.
# OPENAI_API_KEY is read from the process environment. Do not paste it into a tracked file.
VOICE_MODE=cloud
DEPLOYMENT=development
PUBLIC_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
APP_TOKEN=
SIGNING_KEY=
MAX_SESSIONS=4
VAD_BACKEND=silero
VAD_MODEL_PATH=models/silero_vad.onnx
ASR_PROVIDER=openai
OPENAI_ASR_MODEL=gpt-live-transcribe
# delay is accepted by gpt-live-transcribe only (gpt-transcribe and gpt-4o-* reject it).
OPENAI_ASR_DELAY=minimal
TTS_PROVIDER=openai
# Pinned snapshot: measured steadier here than the unpinned alias.
OPENAI_TTS_MODEL=gpt-4o-mini-tts-2025-12-15
OPENAI_TTS_VOICE=cedar
OPENAI_TTS_INSTRUCTIONS=
# Measured: this TTS streams a 0.2 s head chunk, then pauses; occasionally it stalls for
# seconds. Hold 400 ms per phrase and race one unheard duplicate after 2.5 s without it.
TTS_PREBUFFER_MS=400
TTS_HEDGE_SECONDS=2.5
# Responses API (LLM_API=chat keeps Chat Completions for other compatible servers).
# python-dotenv interpolates ${OPENAI_API_KEY} from the environment; the secret stays out of .env.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.6-luna
LLM_API=responses
LLM_API_KEY=${OPENAI_API_KEY}
LLM_SEND_TEMPERATURE=false
LLM_REASONING_EFFORT=none
RTC_ENABLED=true
RTC_ICE_SERVERS_JSON=[]
TWILIO_ENABLED=false
TWILIO_VALIDATE=true
OUTBOUND_ENABLED=false
AUDIOSOCKET_ENABLED=false
